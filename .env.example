# ============================================================
# DOSEBLOOM — Environment Configuration Template
# ============================================================

# Environment Mode: development | production | test
NODE_ENV=development

# Server Port
PORT=5000

# Client App URL (for CORS and Push Notification action links)
APP_BASE_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://localhost:27017/dosebloom
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dosebloom?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/dosebloom

# JWT / Session Secrets (Change to strong random strings in production)
JWT_SECRET=dosebloom_super_secure_jwt_secret_dev_key_2026_xyz!@#
JWT_EXPIRES_IN=7d
SESSION_SECRET=dosebloom_session_secret_cookie_vault_key_2026_dev

# Web Push API (VAPID) Credentials
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BExampleVapidPublicKeyGeneratedViaWebPushLibraryDOSEBLOOM2026TestingKey_ReplaceInProduction
VAPID_PRIVATE_KEY=ExampleVapidPrivateKeyDOSEBLOOM2026_ReplaceInProduction
VAPID_SUBJECT=mailto:support@dosebloom.app

# Worker / Background Scheduler Configuration
# In Render Web Service (Free tier), web server can sleep. Set true on always-on worker or local node.
REMINDER_WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=30000

# Academic Demonstration Mode (Speeds up reminders and enables test triggers without waiting 24 hours)
DEMO_MODE=true

# Initial Admin Bootstrap (Optional one-time safe admin creation)
INITIAL_SETUP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@dosebloom.app
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeInProd123!
BOOTSTRAP_ADMIN_NAME=System Administrator
